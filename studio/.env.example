PORT=3100
APP_ORIGIN=http://localhost:3100
# Required for production; MUST be a different origin from APP_ORIGIN.
PUBLIC_ORIGIN=http://localhost:3101
PUBLIC_PORT=3101
DATA_DIR=.data
# Unset for SQLite; PostgreSQL is recommended for production.
# DATABASE_URL=postgresql://persona:change-me@database:5432/persona
# Set REGISTRATION_OPEN=false after provisioning accounts.
REGISTRATION_OPEN=true
# Custom domains CNAME target; not a DNS ownership substitute.
DOMAIN_TARGET=sites.example.com
# Enable only behind the bundled proxy, which overwrites forwarding headers.
TRUST_PROXY=false
# Optional GitHub release metadata; no client credentials.
UPDATE_REPOSITORY=
# Optional email verification and password reset (never sent unless requested).
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Persona <no-reply@example.com>
# Docker Compose production settings:
# POSTGRES_PASSWORD=use-a-long-url-safe-random-password
# APP_HOST=studio.example.com
# SITES_HOST=sites.example.net
# ACME_EMAIL=operator@example.com
# EXTERNAL_WORKER=true
# BUILD_COMMIT=exact-git-sha

# GitHub update metadata is read by the server only; never expose this token to the client.
RELEASE_CHANNEL=stable
# UPDATE_GITHUB_TOKEN=server-only-read-token-for-private-release-metadata

# X-Center appliance runtime. Keep browser API calls on the editor's own origin.
# PERSONA_APP_ORIGIN=https://persona.xcenter.it
# PERSONA_PUBLIC_ORIGIN=https://persona-sites.xcenter.it
# PERSONA_HOSTED=true
