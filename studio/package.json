{
  "name": "@openrecode/persona",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server/index.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/landing.ts && tsx scripts/sw.ts && tsx scripts/source.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/server/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env src/server/worker.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "export": "tsx --env-file-if-exists=.env scripts/export.ts",
    "format": "prettier --write src scripts tests *.ts",
    "format:check": "prettier --check src scripts tests *.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8"
  }
}
